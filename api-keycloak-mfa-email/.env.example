# Copy this file to .env and fill in the values.
# `make generate-keys` will create the RSA private key for you.

POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Base64-encoded PEM RSA private key used by the BFF (authz) to *decrypt* the
# JWE access token Keycloak emits. The matching public key is served at
# GET /.well-known/jwks.json on the authz container and fetched by Keycloak at
# token-issue time. Generate with `make generate-keys`.
AUTHZ_PRIVATE_KEY_BASE64=

# Base64-encoded PEM RSA private key used by the API to decrypt the inner JWE
# that the BFF re-emits. Generate with `make generate-keys`.
API_PRIVATE_KEY_BASE64=

# Shared HMAC secret used by the wrapper to sign the X-* identity headers
# it emits and by the API to verify them. Production should replace this
# with SPIFFE mTLS — see README "Going production-ready".
WRAPPER_HMAC_SECRET=

JWKS_REFRESH_INTERVAL=300
